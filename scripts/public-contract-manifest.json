{
  "schema_version": 1,
  "description": "Tracked artifacts whose runtime or published copy is governed by feature-contract AT-24.",
  "text_extensions": [
    ".css",
    ".html",
    ".js",
    ".json",
    ".lock",
    ".md",
    ".mjs",
    ".py",
    ".svg",
    ".toml",
    ".ts",
    ".tsx",
    ".yml"
  ],
  "excluded_segments": ["__pycache__", "__tests__", "migrations", "tests"],
  "optional_tracked_artifacts": [
    "PRIVACY_POLICY.md",
    "TERMS_OF_SERVICE.md",
    "RELEASE_NOTES.md",
    "PRODUCTHUNT_LAUNCH.md"
  ],
  "artifacts": [
    { "id": "repository-readme", "path": "README.md" },
    { "id": "root-node-manifest", "path": "package.json" },
    { "id": "root-node-lock", "path": "package-lock.json" },
    { "id": "production-compose", "path": "compose.production.yml" },
    { "id": "mobile-app", "path": "apps/mobile/app", "recursive": true },
    { "id": "mobile-components", "path": "apps/mobile/components", "recursive": true },
    { "id": "mobile-constants", "path": "apps/mobile/constants", "recursive": true },
    { "id": "mobile-hooks", "path": "apps/mobile/hooks", "recursive": true },
    { "id": "mobile-lib", "path": "apps/mobile/lib", "recursive": true },
    { "id": "mobile-stores", "path": "apps/mobile/stores", "recursive": true },
    { "id": "mobile-types", "path": "apps/mobile/types", "recursive": true },
    { "id": "mobile-utils", "path": "apps/mobile/utils", "recursive": true },
    { "id": "mobile-app-manifest", "path": "apps/mobile/app.json" },
    { "id": "mobile-package-manifest", "path": "apps/mobile/package.json" },
    { "id": "mobile-env-contract", "path": "apps/mobile/.env.example" },
    { "id": "mobile-entrypoint", "path": "apps/mobile/index.js" },
    { "id": "mobile-babel-runtime", "path": "apps/mobile/babel.config.js" },
    { "id": "mobile-bundler-runtime", "path": "apps/mobile/metro.config.js" },
    { "id": "mobile-style-runtime", "path": "apps/mobile/global.css" },
    { "id": "mobile-tailwind-runtime", "path": "apps/mobile/tailwind.config.js" },
    { "id": "mobile-typescript-runtime", "path": "apps/mobile/tsconfig.json" },
    { "id": "mobile-nativewind-contract", "path": "apps/mobile/nativewind-env.d.ts" },
    { "id": "mobile-public-logo", "path": "apps/mobile/logo.svg" },
    { "id": "server-config", "path": "apps/server/config", "recursive": true },
    { "id": "server-runtime", "path": "apps/server/core", "recursive": true },
    { "id": "server-templates", "path": "apps/server/templates", "recursive": true },
    { "id": "server-static", "path": "apps/server/static", "recursive": true },
    { "id": "server-package-manifest", "path": "apps/server/pyproject.toml" },
    { "id": "server-package-lock", "path": "apps/server/uv.lock" },
    { "id": "server-env-contract", "path": "apps/server/.env.example" },
    { "id": "server-compose-env-contract", "path": "apps/server/.env.compose.example" },
    { "id": "server-container-runtime", "path": "apps/server/Dockerfile" },
    { "id": "server-command-entrypoint", "path": "apps/server/manage.py" },
    { "id": "store-publication", "path": "docs/store", "recursive": true }
  ]
}
