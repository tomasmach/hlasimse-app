# Local production-like Compose only. Copy to a private file and replace every value.
POSTGRES_DB=hlasimse
POSTGRES_USER=hlasimse
POSTGRES_PASSWORD=replace-with-a-long-url-safe-local-password
DATABASE_URL=postgresql://hlasimse:replace-with-a-long-url-safe-local-password@postgres:5432/hlasimse

DJANGO_SECRET_KEY=replace-with-at-least-50-random-characters-for-local-compose-only
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SECURE_SSL_REDIRECT=false
APP_BASE_URL=https://localhost
DEFAULT_FROM_EMAIL=Hlásím se <noreply@localhost.invalid>
SERVER_EMAIL=Hlásím se <errors@localhost.invalid>
EXPO_ACCESS_TOKEN=replace-with-local-expo-enhanced-push-security-token

GUNICORN_WORKERS=2
GUNICORN_THREADS=4
GUNICORN_FORWARDED_ALLOW_IPS=127.0.0.1
