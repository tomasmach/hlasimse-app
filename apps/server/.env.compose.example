# Local production-like Compose only. Copy to a private file and replace every value.
POSTGRES_DB=hlasimse
POSTGRES_USER=hlasimse
POSTGRES_PASSWORD=replace-with-a-long-url-safe-local-password
DATABASE_URL=postgresql://hlasimse:replace-with-a-long-url-safe-local-password@postgres:5432/hlasimse
# Loopback-only rehearsal escape hatch. Never use outside this Compose topology.
DATABASE_ALLOW_INSECURE_LOCAL_COMPOSE=true
DATABASE_CONNECT_TIMEOUT_SECONDS=5
DATABASE_STATEMENT_TIMEOUT_MS=30000
DATABASE_LOCK_TIMEOUT_MS=5000
DATABASE_IDLE_TRANSACTION_TIMEOUT_MS=15000

DJANGO_SECRET_KEY=replace-with-at-least-50-random-characters-for-local-compose-only
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SECURE_SSL_REDIRECT=false
APP_BASE_URL=https://localhost
DEFAULT_FROM_EMAIL=Hlásím se <noreply@localhost.invalid>
SERVER_EMAIL=Hlásím se <errors@localhost.invalid>
EMAIL_ALLOW_INSECURE_LOCAL_COMPOSE=true
EXPO_ACCESS_TOKEN=replace-with-local-expo-enhanced-push-security-token
MOBILE_MIN_IOS_VERSION=1.0.0
MOBILE_MIN_ANDROID_VERSION=1.0.0
MOBILE_MIN_IOS_BUILD=1
MOBILE_MIN_ANDROID_BUILD=1
MOBILE_IOS_STORE_URL=https://replace-with-real-ios-store-url.invalid
MOBILE_ANDROID_STORE_URL=https://replace-with-real-android-store-url.invalid
MOBILE_API_MAINTENANCE=false
MOBILE_MAINTENANCE_RETRY_AFTER_SECONDS=300
DEADLINE_SWEEPER_ENABLED=true
ALERT_OUTBOX_ENABLED=true
EMAIL_OUTBOX_ENABLED=true

GUNICORN_WORKERS=2
GUNICORN_THREADS=4
GUNICORN_FORWARDED_ALLOW_IPS=127.0.0.1
WEB_TRUSTED_PROXY_CIDRS=
