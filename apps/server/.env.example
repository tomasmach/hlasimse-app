DJANGO_SECRET_KEY=replace-with-at-least-50-random-characters
DJANGO_DEBUG=false
# Required when DJANGO_DEBUG=false. This complete sample is for the one-shot preflight role.
# Long-running services must receive only the provider credentials allowed for their role; see the
# production runbook's role/secret matrix.
HLASIMSE_PROCESS_ROLE=preflight
DJANGO_ALLOWED_HOSTS=app.example.cz
# Production requires sslmode=require, verify-ca, or verify-full.
DATABASE_URL=postgresql://hlasimse:password@database.example.cz:5432/hlasimse?sslmode=verify-full
DATABASE_ALLOW_INSECURE_LOCAL_COMPOSE=false
# Override per process role when a worker has a reviewed longer query budget.
DATABASE_CONNECT_TIMEOUT_SECONDS=5
DATABASE_STATEMENT_TIMEOUT_MS=30000
DATABASE_LOCK_TIMEOUT_MS=5000
DATABASE_IDLE_TRANSACTION_TIMEOUT_MS=15000
DJANGO_SECURE_SSL_REDIRECT=true
# Start with a short measured HSTS window. Raise gradually; enable subdomains/preload only after
# every current and future subdomain is confirmed HTTPS-only.
DJANGO_HSTS_SECONDS=3600
DJANGO_HSTS_INCLUDE_SUBDOMAINS=false
DJANGO_HSTS_PRELOAD=false
# Only alert-outbox, push-receipts, and preflight may receive this secret.
EXPO_ACCESS_TOKEN=replace-with-expo-enhanced-push-security-token
# Required in production. Use the released semantic versions and real HTTPS store pages.
MOBILE_MIN_IOS_VERSION=1.0.0
MOBILE_MIN_ANDROID_VERSION=1.0.0
MOBILE_MIN_IOS_BUILD=1
MOBILE_MIN_ANDROID_BUILD=1
MOBILE_IOS_STORE_URL=
MOBILE_ANDROID_STORE_URL=
MOBILE_API_MAINTENANCE=false
MOBILE_MAINTENANCE_RETRY_AFTER_SECONDS=300
# Independent safety switches. Disabled features fail delivery health and must page an operator.
GUARDIAN_LOCATION_DISCLOSURE_ENABLED=true
DEADLINE_SWEEPER_ENABLED=true
ALERT_OUTBOX_ENABLED=true
EMAIL_OUTBOX_ENABLED=true
APP_BASE_URL=https://app.example.cz
SUPPORT_EMAIL=support@example.cz
# Immutable versions, read-only paths and exact hashes of approved UTF-8 JSON documents.
LEGAL_PRIVACY_VERSION=2026-07-21-v1
LEGAL_PRIVACY_DOCUMENT_PATH=/run/legal/privacy.json
LEGAL_PRIVACY_DOCUMENT_SHA256=replace-with-exact-lowercase-sha256
LEGAL_TERMS_VERSION=2026-07-21-v1
LEGAL_TERMS_DOCUMENT_PATH=/run/legal/terms.json
LEGAL_TERMS_DOCUMENT_SHA256=replace-with-exact-lowercase-sha256
# Only web, email-outbox, and preflight may receive SMTP credentials.
DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.cz
EMAIL_PORT=587
EMAIL_HOST_USER=replace-with-smtp-user
EMAIL_HOST_PASSWORD=replace-with-smtp-password
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
EMAIL_ALLOW_INSECURE_LOCAL_COMPOSE=false
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=Hlásím se <noreply@example.cz>
SERVER_EMAIL=Hlásím se <errors@example.cz>
