DJANGO_SECRET_KEY=replace-with-at-least-50-random-characters
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=api.example.cz
DATABASE_URL=postgresql://hlasimse:password@localhost:5432/hlasimse
DJANGO_SECURE_SSL_REDIRECT=true
EXPO_ACCESS_TOKEN=replace-with-expo-enhanced-push-security-token
APP_BASE_URL=https://app.example.cz
DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.cz
EMAIL_PORT=587
EMAIL_HOST_USER=replace-with-smtp-user
EMAIL_HOST_PASSWORD=replace-with-smtp-password
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=Hlásím se <noreply@example.cz>
SERVER_EMAIL=Hlásím se <errors@example.cz>
